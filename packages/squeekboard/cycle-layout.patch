+/// Map a squeekboard/xkb layout name to the fcitx5 input method name.
+/// Returns None for layouts with no fcitx5 counterpart (fcitx5 untouched).
+fn fcitx5_im_for_layout(name: &str) -> Option<&'static str> {
+    match name {
+        // US English: plain keyboard, no conversion.
+        n if n.starts_with("us") => Some("keyboard-us"),
+        // Japanese: mozc (romaji conversion). Squeekboard shows the jp
+        // kana layout while fcitx5/mozc converts romaji input.
+        n if n.starts_with("jp") => Some("mozc"),
+        _ => None,
+    }
+}
+
+/// Ask fcitx5 to switch input method via
+/// `org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1.SetCurrentIM`.
+/// Best-effort: silently ignored when fcitx5 is not running.
+fn set_fcitx5_im(im: &str) {
+    use gio::prelude::DBusProxyExt;
+    let proxy = gio::DBusProxy::for_bus_sync(
+        gio::BusType::Session,
+        gio::DBusProxyFlags::NONE,
+        None,
+        "org.fcitx.Fcitx5",
+        "/controller",
+        "org.fcitx.Fcitx.Controller1",
+        gio::Cancellable::NONE,
+    );
+    if let Ok(proxy) = proxy {
+        let params = (im.to_variant(),).to_variant();
+        let _ = proxy.call_sync(
+            "SetCurrentIM",
+            Some(&params),
+            gio::DBusCallFlags::NONE,
+            -1,
+            gio::Cancellable::NONE,
+        );
+    }
+}
+
+pub fn cycle_layout(
+    popover: &actors::popover::State,
+    app_state: receiver::State,
+) {
+    let _ = popover;
+    let settings = get_settings("org.gnome.desktop.input-sources");
+    if let Some(settings) = settings {
+        let inputs = variants::get_tuples(settings.value("sources"));
+        if inputs.len() < 2 {
+            return;
+        }
+        let mut rotated = inputs.clone();
+        rotated.rotate_left(1);
+        let _ = settings.set_value(
+            "sources",
+            &variants::ArrayPairString(rotated.clone()).to_variant(),
+        );
+        settings.apply();
+        let (kind, name) = rotated.into_iter().next().unwrap();
+        if let Some(im) = fcitx5_im_for_layout(&name) {
+            set_fcitx5_im(im);
+        }
+        let layout = LayoutId::System {
+            kind,
+            name,
+        };
+        let _ = app_state.send(state::Event::OverlayChanged(layout));
+    }
+}
